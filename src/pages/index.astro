---
import StaffLayout from '../layouts/StaffLayout.astro';

const base = import.meta.env.BASE_URL;
const linkTo = (path = '') => `${base}${path}`;

const announcements = [
	{
		title: 'Quarterly planning materials are available',
		body: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec vitae sapien sed metus facilisis consequat.',
		date: 'August 6, 2026',
		datetime: '2026-08-06',
	},
	{
		title: 'Office maintenance notice',
		body: 'Praesent commodo, sapien quis malesuada consequat, tellus neque tincidunt tortor, vitae egestas velit arcu sed sem.',
		date: 'August 4, 2026',
		datetime: '2026-08-04',
	},
];

const events = [
	{
		month: 'AUG',
		day: '12',
		title: 'All-staff meeting',
		details: '10:00 a.m.–11:30 a.m. · Solomon’s Court',
		datetime: '2026-08-12T10:00:00',
	},
	{
		month: 'AUG',
		day: '20',
		title: 'Equipped webinar',
		details: '1:00 p.m.–2:00 p.m. · Online',
		datetime: '2026-08-20T13:00:00',
	},
	{
		month: 'SEP',
		day: '03',
		title: 'Department planning session',
		details: '9:00 a.m.–12:00 p.m. · The Vineyard',
		datetime: '2026-09-03T09:00:00',
	},
];

const absences = [
	{
		name: 'Alex Morgan',
		dates: 'August 10–14',
		note: 'Vacation',
	},
	{
		name: 'Jordan Lee',
		dates: 'August 12',
		note: 'Out of office',
	},
	{
		name: 'Taylor Smith',
		dates: 'August 18–19',
		note: 'Conference',
	},
];

const recentProcedures = [
	{
		title: 'Employee onboarding checklist',
		section: 'HR Processes',
		owner: 'Human Resources',
		date: 'August 5, 2026',
		datetime: '2026-08-05',
		href: linkTo('hr/onboarding/'),
	},
	{
		title: 'Webinar planning process',
		section: 'Events',
		owner: 'Administration',
		date: 'August 2, 2026',
		datetime: '2026-08-02',
		href: linkTo('events/webinars/'),
	},
	{
		title: 'Eblast review and approval',
		section: 'Marketing Processes',
		owner: 'Marketing',
		date: 'July 30, 2026',
		datetime: '2026-07-30',
		href: linkTo('marketing/eblasts/'),
	},
	{
		title: 'New member onboarding',
		section: 'Member Support',
		owner: 'Member Support',
		date: 'July 28, 2026',
		datetime: '2026-07-28',
		href: linkTo('member-support/onboarding/'),
	},
];
---

<StaffLayout title="Home" activeSection="Home">
	<div class="home-page">
		<section class="hero" aria-labelledby="welcome-heading">
			<div class="hero-copy">
				<p class="eyebrow">CCCC staff intranet</p>

				<h1 id="welcome-heading">Welcome, staff</h1>

				<p class="end-statement">
					<strong>CCCC End Statement placeholder.</strong>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
				</p>
			</div>

			<div class="hero-image-placeholder" aria-hidden="true">
				<span>Hero image placeholder</span>
			</div>
		</section>

		<section
			class="dashboard-section"
			aria-labelledby="announcements-heading"
		>
			<div class="section-heading">
				<div>
					<p class="eyebrow">Latest information</p>
					<h2 id="announcements-heading">Announcements</h2>
				</div>
			</div>

			<div class="announcement-list">
				{
					announcements.map((announcement) => (
						<article class="announcement">
							<div class="announcement-marker" aria-hidden="true">
								!
							</div>

							<div>
								<h3>{announcement.title}</h3>

								<p>{announcement.body}</p>

								<p class="item-meta">
									Posted{' '}
									<time datetime={announcement.datetime}>
										{announcement.date}
									</time>
								</p>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<div class="dashboard-grid">
			<section class="panel" aria-labelledby="events-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Calendar</p>
						<h2 id="events-heading">Upcoming events</h2>
					</div>
				</div>

				<ol class="event-list">
					{
						events.map((event) => (
							<li class="event-item">
								<time
									class="event-date"
									datetime={event.datetime}
								>
									<span>{event.month}</span>
									<strong>{event.day}</strong>
								</time>

								<div>
									<h3>{event.title}</h3>
									<p>{event.details}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section class="panel" aria-labelledby="absences-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Availability</p>
						<h2 id="absences-heading">Staff absences</h2>
					</div>
				</div>

				<ul class="absence-list">
					{
						absences.map((absence) => (
							<li>
								<div
									class="person-placeholder"
									aria-hidden="true"
								>
									{absence.name
										.split(' ')
										.map((part) => part[0])
										.join('')}
								</div>

								<div>
									<h3>{absence.name}</h3>
									<p>
										<strong>{absence.dates}</strong>
										<span aria-hidden="true"> · </span>
										{absence.note}
									</p>
								</div>
							</li>
						))
					}
				</ul>
			</section>
		</div>

		<section
			class="panel recent-panel"
			aria-labelledby="recent-heading"
		>
			<div class="section-heading">
				<div>
					<p class="eyebrow">Procedure library</p>
					<h2 id="recent-heading">
						Recently updated procedures
					</h2>
				</div>
			</div>

			<ul class="recent-list">
				{
					recentProcedures.map((procedure) => (
						<li>
							<div class="procedure-details">
								<a href={procedure.href}>
									{procedure.title}
								</a>

								<p>{procedure.section}</p>
							</div>

							<div class="procedure-owner">
								<span class="list-label">Owner</span>
								<span>{procedure.owner}</span>
							</div>

							<div class="procedure-updated">
								<span class="list-label">Last updated</span>
								<time datetime={procedure.datetime}>
									{procedure.date}
								</time>
							</div>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</StaffLayout>

<style>
	.home-page {
		display: grid;
		gap: 1.5rem;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
		min-height: 20rem;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.8rem;
	}

	.hero-copy {
		align-self: center;
		padding: 3rem;
	}

	.hero h1 {
		max-width: 15ch;
		margin: 0.15rem 0 1rem;
		color: var(--navy-dark);
		font-size: clamp(2.4rem, 5vw, 4.25rem);
		line-height: 1.05;
	}

	.end-statement {
		max-width: 48rem;
		margin: 0;
		color: var(--muted);
		font-size: 1.08rem;
	}

	.hero-image-placeholder {
		display: grid;
		min-height: 20rem;
		place-items: center;
		padding: 2rem;
				background:
			linear-gradient(
				165deg,
				var(--brand-blue),
				var(--brand-purple)
			);
		color: #ffffff;
		font-weight: 700;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 0.25rem;
				color: var(--brand-blue);
		border-left: 0.25rem solid var(--brand-teal);
		padding-left: 0.5rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.dashboard-section,
	.panel {
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.8rem;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--navy-dark);
		font-size: 1.55rem;
	}

	.announcement-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.announcement {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		padding: 1.1rem;
		background: var(--brand-cream);
		border-left: 0.35rem solid var(--brand-coral);
		border-radius: 0.45rem;
	}

	.announcement-marker {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 50%;
		background: var(--brand-coral);
		color: var(--text);
		font-weight: 700;
	}

	.announcement h3,
	.event-item h3,
	.absence-list h3 {
		margin: 0;
		color: var(--navy-dark);
		font-size: 1rem;
	}

	.announcement p,
	.event-item p,
	.absence-list p {
		margin: 0.3rem 0 0;
	}

	.item-meta {
		color: var(--muted);
		font-size: 0.82rem;
	}

	.dashboard-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.event-list,
	.absence-list,
	.recent-list {
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.event-item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--border);
	}

	.event-item:first-child,
	.absence-list li:first-child,
	.recent-list li:first-child {
		border-top: 0;
	}

	.event-date {
		display: grid;
		width: 3.7rem;
		min-height: 3.7rem;
		place-items: center;
		align-content: center;
		border-radius: 0.4rem;
		background: var(--navy);
		color: #ffffff;
		line-height: 1;
		text-align: center;
	}

	.event-date span {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.event-date strong {
		margin-top: 0.25rem;
		font-size: 1.35rem;
	}

	.absence-list li {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--border);
	}

	.person-placeholder {
		display: grid;
		width: 2.8rem;
		height: 2.8rem;
		place-items: center;
		border-radius: 50%;
		background: var(--green);
		color: #ffffff;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.recent-list li {
		display: grid;
		grid-template-columns:
			minmax(15rem, 1.5fr)
			minmax(10rem, 0.75fr)
			minmax(9rem, 0.6fr);
		gap: 1.5rem;
		align-items: center;
		padding: 1rem 0;
		border-top: 1px solid var(--border);
	}

	.procedure-details a {
		color: var(--blue);
		font-weight: 700;
	}

	.procedure-details p {
		margin: 0.15rem 0 0;
		color: var(--muted);
		font-size: 0.87rem;
	}

	.procedure-owner,
	.procedure-updated {
		display: grid;
		gap: 0.15rem;
	}

	.list-label {
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	@media (max-width: 70rem) {
		.hero {
			grid-template-columns: 1fr;
		}

		.hero-image-placeholder {
			min-height: 10rem;
		}

		.announcement-list,
		.dashboard-grid {
			grid-template-columns: 1fr;
		}

		.recent-list li {
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}
	}
</style>