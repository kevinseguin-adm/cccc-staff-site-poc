		<section
			id="scope"
			class="procedure-section"
			aria-labelledby="scope-heading"
		>
			<h2 id="scope-heading">Scope</h2>

			<p>
				This placeholder procedure applies to all newly hired
				employees. Department-specific orientation activities may be
				added by the employee’s manager.
			</p>

			<aside class="callout" aria-labelledby="note-heading">
