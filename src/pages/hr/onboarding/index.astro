				</p>
			</aside>
		</section>

		<section
			id="responsibilities"
			class="procedure-section"
			aria-labelledby="responsibilities-heading"
		>
			<h2 id="responsibilities-heading">Responsibilities</h2>

			<div class="table-wrapper" tabindex="0">
				<table>
					<caption>
						Onboarding responsibilities by role
