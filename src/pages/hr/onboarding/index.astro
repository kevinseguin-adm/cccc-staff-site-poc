---
import ProcedureLayout from '../../../layouts/ProcedureLayout.astro';

const googleDocUrl =
	'https://docs.google.com/document/d/e/2PACX-1vS42xjarlzorVRP1cEYNmR2cXsViTGzWf_VjlLTpFrdC2JcDmjaIJHomolp2Gd5-1LYwF41nzyLqbB5/pub';

const response = await fetch(googleDocUrl);

if (!response.ok) {
	throw new Error(`Could not fetch Google Doc: ${response.status}`);
}

const html = await response.text();

function cleanGoogleDocHtml(rawHtml: string) {
	const bodyMatch = rawHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i);

	if (!bodyMatch) {
		return '<p>Google Doc content could not be loaded.</p>';
	}

	let content = bodyMatch[1];

	// Start at the actual Google Doc content.
	content = content.replace(
		/^[\s\S]*?(<div id=["']contents["'][^>]*>)/i,
		'$1'
	);

	// Remove scripts after the document content.
	content = content.replace(
		/<script[\s\S]*?<\/script>/gi,
		''
	);

	// Remove broken images and empty image placeholders.
	content = content
		.replace(/<img\b[^>]*>/gi, '')
		.replace(/<span\b[^>]*>\s*<\/span>/gi, '');

	// Remove Google Docs footer paragraphs such as “Page  of”.
	content = content.replace(
		/<p\b[^>]*>\s*<span\b[^>]*>[\s\u00a0]*Page[\s\u00a0]*<\/span>\s*<span\b[^>]*>[\s\u00a0]*of[\s\u00a0]*<\/span>\s*<\/p>/gi,
		''
	);

	// Repeatedly remove empty paragraphs, empty headings, and empty divs.
	let previousContent = '';

	while (previousContent !== content) {
		previousContent = content;

		content = content
			.replace(/<(p|h[1-6])\b[^>]*>\s*<\/\1>/gi, '')
			.replace(/<div\b[^>]*>\s*<\/div>/gi, '');
	}

	return content.trim();
}

const googleDocBody = cleanGoogleDocHtml(html);
---

<ProcedureLayout
	title="Employee onboarding"
	activeSection="HR Processes"
	processArea="HR Processes"
	processHref="hr/"
	owner="Human Resources"
	lastUpdated="August 7, 2026"
	lastUpdatedISO="2026-08-07"
	documentType="Procedure"
	summary="A placeholder process for preparing, welcoming and orienting a newly hired employee."
>

<div class="procedure-body google-doc-content" set:html={googleDocBody} />
</ProcedureLayout>

<style>
    
	.procedure-body {
		max-width: 72rem;
	}

	.page-contents {
		padding: 1.25rem;
		background: var(--brand-blue-grey);
		border-left: 0.35rem solid var(--brand-purple);
		border-radius: 0.55rem;
	}

	.page-contents h2 {
		margin: 0 0 0.75rem;
		color: var(--navy-dark);
		font-size: 1rem;
	}

	.page-contents ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.page-contents a {
		font-weight: 700;
	}

	.procedure-section {
		margin-top: 2.5rem;
		scroll-margin-top: 6rem;
	}

	.procedure-section > h2 {
		margin: 0 0 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--brand-blue-grey);
		color: var(--navy-dark);
		font-size: 1.6rem;
	}

	.procedure-section h3 {
		color: var(--navy-dark);
	}

	.procedure-section p,
	.procedure-section li {
		max-width: 75ch;
	}

	.callout {
		margin-top: 1.5rem;
		padding: 1.25rem;
		background: var(--brand-cream);
		border-left: 0.35rem solid var(--brand-coral);
		border-radius: 0.45rem;
	}

	.callout h3 {
		margin: 0;
		font-size: 1rem;
	}

	.callout p {
		margin: 0.4rem 0 0;
	}

	.steps {
		display: grid;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
		counter-reset: procedure-step;
	}

	.steps > li {
		position: relative;
		min-height: 5rem;
		padding: 1.25rem 1.25rem 1.25rem 4.5rem;
		border: 1px solid var(--border);
		border-radius: 0.55rem;
		counter-increment: procedure-step;
	}

	.steps > li::before {
		position: absolute;
		top: 1.15rem;
		left: 1.15rem;
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border-radius: 50%;
		background: var(--brand-blue);
		color: #ffffff;
		font-weight: 700;
		content: counter(procedure-step);
	}

	.steps h3 {
		margin: 0;
		font-size: 1.1rem;
	}

	.steps p {
		margin: 0.5rem 0 0;
	}

	.steps ul {
		margin-top: 0.75rem;
	}

	.checklist {
		display: grid;
		gap: 0.65rem;
		padding-left: 1.5rem;
	}

	.checklist li::marker {
		color: var(--brand-teal);
	}

	.table-wrapper {
		max-width: 100%;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
	}

	.table-wrapper:focus-visible {
		outline: 3px solid var(--navy-dark);
		outline-offset: 3px;
		box-shadow: 0 0 0 6px var(--focus);
	}

	table {
		width: 100%;
		min-width: 40rem;
		border-collapse: collapse;
		background: #ffffff;
	}

	caption {
		padding: 0.8rem 1rem;
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 700;
		text-align: left;
	}

	th,
	td {
		padding: 0.9rem 1rem;
		border-top: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	thead th {
		background: var(--brand-blue-grey);
		color: var(--navy-dark);
	}

	tbody th {
		width: 13rem;
		color: var(--navy-dark);
	}
	.google-doc-content {
		padding-top: 0;
	}

	.google-doc-content #contents {
		margin-top: 0 !important;
		padding-top: 0 !important;
	}

	.google-doc-content #contents > *:first-child {
		margin-top: 0 !important;
		padding-top: 0 !important;
	}

	.google-doc-content img {
		display: none !important;
	}
	@media (max-width: 48rem) {
		.steps > li {
			padding: 4.25rem 1rem 1rem;
		}

		.steps > li::before {
			top: 1rem;
			left: 1rem;
		}
	}
    	:global(.google-doc-content #contents),
	:global(.google-doc-content .doc-content) {
		margin-top: 0 !important;
		padding-top: 0 !important;
	}

	:global(.google-doc-content .doc-content > h1:first-child) {
		margin-top: 0 !important;
		padding-top: 0 !important;
	}

	:global(.google-doc-content .doc-content > h1:first-child span) {
		margin-top: 0 !important;
		padding-top: 0 !important;
	}
</style>