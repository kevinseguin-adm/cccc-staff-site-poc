					<thead>
						<tr>
							<th scope="col">Role</th>
							<th scope="col">Responsibility</th>
						</tr>
					</thead>

					<tbody>
						<tr>
							<th scope="row">Human Resources</th>
							<td>
								Prepare employment documentation, establish
								the employee record and coordinate
								organisation-wide orientation.
							</td>
						</tr>

						<tr>
							<th scope="row">Hiring manager</th>
							<td>
								Prepare the work plan, assign equipment,
