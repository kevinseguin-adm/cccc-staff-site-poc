</ProcedureLayout>

<style>
	.procedure-body {
		max-width: 72rem;
	}

	.page-contents {
		padding: 1.25rem;
		background: var(--brand-blue-grey);
		border-left: 0.35rem solid var(--brand-purple);
		border-radius: 0.55rem;
	}

	.page-contents h2 {
		margin: 0 0 0.75rem;
		color: var(--navy-dark);
		font-size: 1rem;
	}

	.page-contents ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.page-contents a {
		font-weight: 700;
	}

	.procedure-section {
		margin-top: 2.5rem;
		scroll-margin-top: 6rem;
	}

	.procedure-section > h2 {
		margin: 0 0 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--brand-blue-grey);
		color: var(--navy-dark);
		font-size: 1.6rem;
	}

	.procedure-section h3 {
		color: var(--navy-dark);
	}

	.procedure-section p,
	.procedure-section li {
		max-width: 75ch;
	}

	.callout {
		margin-top: 1.5rem;
		padding: 1.25rem;
		background: var(--brand-cream);
		border-left: 0.35rem solid var(--brand-coral);
		border-radius: 0.45rem;
	}

	.callout h3 {
		margin: 0;
		font-size: 1rem;
	}

	.callout p {
		margin: 0.4rem 0 0;
	}

	.steps {
		display: grid;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
		counter-reset: procedure-step;
	}

	.steps > li {
		position: relative;
		min-height: 5rem;
		padding: 1.25rem 1.25rem 1.25rem 4.5rem;
		border: 1px solid var(--border);
		border-radius: 0.55rem;
		counter-increment: procedure-step;
	}

	.steps > li::before {
		position: absolute;
		top: 1.15rem;
		left: 1.15rem;
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border-radius: 50%;
		background: var(--brand-blue);
		color: #ffffff;
		font-weight: 700;
		content: counter(procedure-step);
	}

	.steps h3 {
		margin: 0;
		font-size: 1.1rem;
	}

	.steps p {
		margin: 0.5rem 0 0;
	}

	.steps ul {
		margin-top: 0.75rem;
	}

	.checklist {
		display: grid;
		gap: 0.65rem;
		padding-left: 1.5rem;
	}

	.checklist li::marker {
		color: var(--brand-teal);
	}

	.table-wrapper {
		max-width: 100%;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
	}

	.table-wrapper:focus-visible {
		outline: 3px solid var(--navy-dark);
		outline-offset: 3px;
		box-shadow: 0 0 0 6px var(--focus);
	}

	table {
		width: 100%;
		min-width: 40rem;
		border-collapse: collapse;
		background: #ffffff;
	}

	caption {
		padding: 0.8rem 1rem;
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 700;
		text-align: left;
	}

	th,
	td {
		padding: 0.9rem 1rem;
		border-top: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	thead th {
		background: var(--brand-blue-grey);
		color: var(--navy-dark);
	}

	tbody th {
		width: 13rem;
		color: var(--navy-dark);
	}

	@media (max-width: 48rem) {
		.steps > li {
			padding: 4.25rem 1rem 1rem;
		}

		.steps > li::before {
			top: 1rem;
			left: 1rem;
		}
	}
</style>